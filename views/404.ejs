<%- include('partials/header') %>

<div class="container page-content">
  <div class="error-page-container">
    <div class="error-code-badge">HTTP 404</div>
    <h1 class="error-title">Route Not Found</h1>
    <p class="error-message">
      The Express router searched for a match for <code><%= requestedUrl %></code>, but no route handler was registered.
    </p>

    <div class="error-explanation-box">
      <h3>💡 How Express handles 404 in SSR:</h3>
      <p>In Express, 404 is not an exception—it's simply the end of the middleware chain where no route matched.</p>
      <pre><code>// Catch-all middleware placed at the very end of app.js
app.use((req, res) => {
  res.status(404).render('404', {
    requestedUrl: req.originalUrl,
    message: 'Page not found'
  });
});</code></pre>
    </div>

    <div class="error-actions">
      <a href="/" class="btn btn-primary">
        <span>🏠</span> Return to Home Page
      </a>
      <a href="/students" class="btn btn-secondary">
        <span>👥</span> View Student Directory
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
